// ════════════════════════════════════════════════════════════════════════
// Configuración de Cloudflare Workers (Assets) para la web LICUADO.
// ¡¡IMPORTANTE!! Este archivo DEBE estar commiteado en la RAÍZ del repo.
//
// El pipeline de Cloudflare ejecuta directamente "npx wrangler deploy" sin
// compilar nada; si no encuentra esta configuración, wrangler entra en modo
// interactivo/autoconfig y re-genera un dist/wrangler.json propio con
// _redirects heredados → error 100324:
//   "Invalid _redirects configuration: Infinite loop detected"
//
// Con este archivo presente y válido, wrangler NO regenera nada y sube solo
// los assets de dist/.
//
// (Este archivo estaba corrupto: contenía DOS objetos JSON concatenados —una
// fusión mala de dos versiones— lo que provocaba el fallo de parseo
// "PropertyNameExpected" en la línea 22 durante el deploy.)
// ════════════════════════════════════════════════════════════════════════
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "licuado",
  "compatibility_date": "2026-09-30",
  "observability": {
    "enabled": true
  },
  "assets": {
    // dist/ está commiteado a propósito: el pipeline no corre "npm run build".
    "directory": "./dist",
    // SPA: cualquier ruta desconocida (/Mitte signum, /LICUADO Scriptorium,
    // /nuntium, /editor, …) sirve index.html con código 200. Se hace mediante
    // esta opción y NO mediante _redirects, para evitar el error 100324.
    "not_found_handling": "single-page-application"
    // Nota: no se usa "_redirects" en dist/ (la SPA ya se resuelve con
    // not_found_handling), así que no hace falta excluirlo del bundle.
  }
}
